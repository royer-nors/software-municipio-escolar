{
  "name": "software-municipio-escolar-servidor",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación Electron para el servidor del Municipio Escolar",
  "main": "servidor/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:puesto": "electron puesto/main.cjs",
    "test:puesto": "node --test puesto/test/*.test.cjs",
    "pack:servidor": "node scripts/dist.cjs pack-servidor",
    "pack:puesto": "node scripts/dist.cjs pack-puesto",
    "dist:servidor": "node scripts/dist.cjs servidor",
    "dist:puesto": "node scripts/dist.cjs puesto",
    "dist:todo": "node scripts/dist.cjs todo"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "26.18.0"
  }
}
