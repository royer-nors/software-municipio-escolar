{
  "name": "software-municipio-escolar-servidor",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación Electron para el servidor del Municipio Escolar",
  "main": "servidor/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:puesto": "electron puesto/main.cjs",
    "pack:servidor": "electron-builder --dir --config electron-builder.cjs",
    "pack:puesto": "electron-builder --win nsis --config electron-builder.puesto.cjs"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "26.18.0"
  }
}
