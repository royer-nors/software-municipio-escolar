PORT=3000
# Secure por defecto. false solo para pruebas HTTP en loopback, nunca LAN real.
PUESTO_COOKIE_SECURE=true
# Solo tras configurar proxy HTTPS local; exige HOST de loopback.
PUESTO_PROXY_LOOPBACK=false
# Local por defecto. Para LAN autorizada: IP de la interfaz del servidor o 0.0.0.0.
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Solo si se utiliza Electron empaquetado con loadFile; ver ETAPA_2_LAN.md.
CORS_ALLOW_NULL_ORIGIN=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=municipio_escolar
DB_USER=postgres
DB_PASSWORD=
# Generar un secreto aleatorio siguiendo backend/README.md.
JWT_SECRET=
# Salvaguardas del módulo Borrar datos. Mantener deshabilitado fuera de pruebas.
BORRADO_DATOS_HABILITADO=false
BORRADO_DATOS_DB_PRUEBAS=municipio_escolar_pruebas
BORRADO_DATOS_REINICIO_HABILITADO=false
BORRADO_DATOS_AUTORIZACION_REINICIO=
